{
  "name": "spikerz-automation",
  "version": "1.0.0",
  "description": "Cypress automation for the Spikerz social connect YouTube flow.",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "cypress": "npm run cypress:run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --spec cypress/e2e/youtube-connect.cy.ts --browser chrome",
    "automation:run": "npm run cypress:run",
    "test": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "cypress": "^15.15.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
